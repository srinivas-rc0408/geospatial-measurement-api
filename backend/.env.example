# Copy to .env and adjust. Every variable is optional; the defaults run the project with zero setup.
# .env is git-ignored: real connection strings and secrets never go in this file.

# Database the app uses at runtime (SQLite by default; on Neon the POOLED URL, host contains "-pooler").
GEO_DATABASE_URL=sqlite:///./data/geo.db
# GEO_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Database `alembic upgrade head` migrates; falls back to GEO_DATABASE_URL (on Neon the DIRECT URL, no "-pooler").
# GEO_MIGRATIONS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require

# Browser origins allowed to call the API, comma-separated (e.g. the deployed frontend); never "*" in production.
GEO_CORS_ORIGINS=http://localhost:5173

# Folder where uploaded files are stored.
GEO_STORAGE_DIR=./data/uploads

# Maximum upload size in MB (requests above it get 413).
GEO_MAX_UPLOAD_MB=50

# ZIP-bomb guard: maximum total uncompressed size of a ZIP/KMZ in MB.
GEO_MAX_UNCOMPRESSED_MB=500

# ZIP-bomb guard: maximum number of files inside a ZIP/KMZ.
GEO_MAX_ARCHIVE_MEMBERS=500

# Shapefile without .prj: assume EPSG:4326 (with a warning) when every coordinate fits lon/lat bounds.
GEO_ASSUME_WGS84_WHEN_CRS_MISSING=true

# Projected-vs-geodesic difference (%) above which a feature gets a warning.
GEO_MEASUREMENT_DIVERGENCE_WARNING_PCT=0.5
