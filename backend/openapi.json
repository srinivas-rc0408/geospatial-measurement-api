  "info": {
    "description": "\nUpload a **Shapefile (.zip)** or **KML/KMZ** file and get, for every feature, its geometry,\nCRS, attributes and measurements: **area** for polygons and **length** for lines, computed in\na local UTM projection (never in raw degrees) and cross-checked against geodesic values.\n",
    "title": "Geospatial File Measurement API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/config": {
      "get": {
        "description": "The upload size limit and accepted file extensions, so a client can check a file before sending it.",
        "operationId": "client_config_api_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfig"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Upload limits for clients",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/files/": {
      "get": {
        "operationId": "list_files_api_files__get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/FileStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "description": "Page size.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "Page size.",
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Number of items to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Number of items to skip.",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List uploaded files",
        "tags": [
          "files"
        ]
      },
      "post": {
        "description": "Validates the upload synchronously, then reads and measures it in the background.\n\nA plain ``def`` on purpose: FastAPI runs it in a worker thread, so the blocking disk and\ndatabase I/O below never stalls the event loop.\n\nReturns **202 Accepted** with `status: PENDING`. Poll `GET /api/files/{id}` until\n`COMPLETED` (or `FAILED`, with the reason in `error`).\n\nEach client address may upload `GEO_UPLOAD_RATE_LIMIT` files (default 20) per\n`GEO_UPLOAD_RATE_WINDOW_SECONDS` (default 600); beyond that, **429** with `Retry-After`.",
        "operationId": "upload_file_api_files__post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_api_files__post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "File too large."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported file type."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "File is corrupt or incomplete."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many uploads from this address; see Retry-After."
          }
        },
        "summary": "Upload a geospatial file",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/{file_id}": {
      "delete": {
        "operationId": "delete_file_api_files__file_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "title": "File Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "File not found."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "File not processed yet, or processing failed."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a file",
        "tags": [
          "files"
        ]
      },
      "get": {
        "operationId": "get_file_api_files__file_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "title": "File Id",
              "type": "string"
